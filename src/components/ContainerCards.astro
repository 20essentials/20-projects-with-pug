<style>
  section {
    min-height: 100vh;
    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));
    position: relative;
    place-content: center;
    place-items: center;
  }

  .view {
    position: relative;
    width: 19.53vmax;
    height: 19.53vmax;
    border: 0.33vmax solid black;
    border-radius: 50%;
    overflow: hidden;
    background-image: var(--bg);
    background-size: cover;
    background-position: center;
    zoom: 0.8;
  }

  .lamp {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 26.04vmax;
    opacity: 0;
    z-index: 300;
  }

  .lamp-left {
    animation: lamp-pass-left 2s ease-in 1s infinite;
  }

  .lamp-right {
    animation: lamp-pass-right 2s ease-in 2s infinite;
  }

  .head {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .light-source {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0vmax 0vmax 13.02vmax 3.26vmax #dfd89c;
    z-index: 3;
  }

  .head-top {
    height: 0.98vmax;
    width: 0.65vmax;
    background-color: #000;
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
  }

  .head-body {
    height: 5.21vmax;
    width: 4.56vmax;
    border-top: 0.98vmax solid black;
    border-bottom: 0.98vmax solid black;

    clip-path: polygon(0% 0%, 100% 0%, 80% 100%, 20% 100%);
    border-top-left-radius: 20%;
    border-top-right-radius: 20%;
    overflow: hidden;
    display: flex;
    background-color: #dfd89c;
    flex-direction: row;
    align-items: stretch;
  }

  .head-body-rod {
    width: 0.52vmax;
    background-color: black;
  }

  .head-body-rod:nth-child(1) {
    transform: skewX(7deg);
    width: 0.98vmax;
  }

  .head-body-rod:nth-child(5) {
    transform: skewX(-7deg);
    width: 0.98vmax;
  }

  .head-body-glass {
    flex: 1;
  }

  .rod {
    flex: 1;
    background-color: black;
    width: 0.98vmax;
  }

  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 2.6vmax;
    height: 5.21vmax;
    box-shadow: inset 0vmax 0.13vmax 0.2vmax #5d5f3f;
    border-top-left-radius: 30%;
    border-top-right-radius: 30%;
    border-bottom-left-radius: 20%;
    border-bottom-right-radius: 20%;
    background: linear-gradient(0deg, #000 50%, #373829);
  }

  .bottom-top {
    margin-top: 1.3vmax;
    width: 3.26vmax;
    height: 0.65vmax;
    box-shadow: inset 0vmax 0.13vmax 0.2vmax #5d5f3f;
    background: linear-gradient(0deg, #000 70%, #5d5f3f);
    border-radius: 30%;
  }

  .bottom-body {
    flex: 1;
  }

  .bottom-bottom {
    width: 3.26vmax;
    height: 1.95vmax;
    background: linear-gradient(0deg, #000 50%, #373829);
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
  }

  .lamp-shadow {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: -0.65vmax;
    width: 9.77vmax;
    height: 1.04vmax;
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-left-radius: 90%;
    border-bottom-right-radius: 90%;
    background: radial-gradient(circle, #000 0%, transparent 100%);
  }

  .masonry-perspective {
    perspective: 9.77vmax;
    width: 5.86vmax;
    height: 9.77vmax;
    margin-bottom: -5.91vmax;
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .masonry-container {
    transform: rotateX(50deg) !important;
    transform-style: preserve-3d;
    width: 100%;
  }

  .masonry {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(0.98vmax, 1fr));
    padding-bottom: 0.98vmax;
    gap: 1px;
    width: 100%;
    height: 10px;
    position: absolute;
    opacity: 0;
    background-color: #222;
  }

  .masonry:nth-child(1) {
    animation: walk 2s linear infinite;
  }
  .masonry:nth-child(2) {
    animation: walk 2s linear 0.2s infinite;
  }
  .masonry:nth-child(3) {
    animation: walk 2s linear 0.4s infinite;
  }
  .masonry:nth-child(4) {
    animation: walk 2s linear 0.6s infinite;
  }
  .masonry:nth-child(5) {
    animation: walk 2s linear 0.8s infinite;
  }
  .masonry:nth-child(6) {
    animation: walk 2s linear 1s infinite;
  }
  .masonry:nth-child(7) {
    animation: walk 2s linear 1.2s infinite;
  }
  .masonry:nth-child(8) {
    animation: walk 2s linear 1.4s infinite;
  }
  .masonry:nth-child(9) {
    animation: walk 2s linear 1.6s infinite;
  }
  .masonry:nth-child(10) {
    animation: walk 2s linear 1.8s infinite;
  }

  .masonry-item {
    background-color: #fff;
    border-radius: 0.2vmax;
    padding: 0.07vmax;
    box-shadow:
      inset 0.07vmax 0.07vmax 0.2vmax #5d5f3f,
      inset -0.07vmax -0.07vmax 0.39vmax #222;
    font-size: 1.56vmax;

    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #444;
  }

  /* Farklı boyutlarda öğeler eklemek için */
  .masonry:nth-child(even) .masonry-item:nth-child(odd) {
    height: 1.3vmax;
  }
  .masonry:nth-child(odd) .masonry-item:nth-child(even) {
    height: 1.56vmax;
  }
  .masonry:nth-child(odd) .masonry-item:nth-child(odd) {
    height: 1.56vmax;
  }
  .masonry:nth-child(odd) .masonry-item:nth-child(even) {
    height: 1.3vmax;
  }

  @keyframes walk {
    0% {
      opacity: 0;
      transform: translateY(-900%);
    }
    20% {
      opacity: 0;
    }
    50% {
      opacity: 1;
      transform: translateY(0%);
    }
    80% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(900%);
    }
  }

  @keyframes lamp-pass-right {
    0% {
      opacity: 0;
      transform: translateX(-10%) translateY(-50%) scale(0.2);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translateX(250%) translateY(-40%) scale(1.2);
    }
  }
  
  @keyframes lamp-pass-left {
    0% {
      opacity: 0;
      transform: translateX(-90%) translateY(-50%) scale(0.2);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translateX(-350%) translateY(-40%) scale(1.2);
    }
  }
</style>
