<section>
  <h1>20 PROJECTS WITH PUG <img src='/assets/pug.png' alt='PUG LOGO' /></h1>
  <div id='smoke'></div>
</section>

<script is:inline>
  let smoke = document.getElementById("smoke");

  function createSmokeFromCoords(x, y) {
    const elemnt = document.createElement("div");
    elemnt.classList.add("elem");

    elemnt.style.left = `${x}px`;
    elemnt.style.top = `${y}px`;
    smoke.appendChild(elemnt);

    elemnt.addEventListener("animationend", () => {
      elemnt.remove();
    });
  }

  function createSmoke(e) {
    createSmokeFromCoords(e.clientX, e.clientY);
  }

  function createSmokeTouch(e) {
    if (e.touches && e.touches.length > 0) {
      const touch = e.touches[0];
      createSmokeFromCoords(touch.clientX, touch.clientY);
    }
  }

  document.addEventListener("mousemove", createSmoke);
  document.addEventListener("touchmove", createSmokeTouch);
</script>


<style>
  @keyframes fadeIn {
    from {
      transform: translate(-50%, -50%) scale(0);
    }
    to {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  :global(.elem) {
    position: absolute;
    width: 2vmax;
    height: 2vmax;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 1) 0%,
      rgba(0, 0, 0, 0) 80%
    );
    pointer-events: none;
    animation: ripple 2s ease-in-out forwards;
  }

  @keyframes ripple {
    0% {
      transform: scale(0) translateY(0);
      opacity: 1;
    }
    100% {
      transform: scale(10) translateY(-1vmax);
      opacity: 0;
    }
  }

  #smoke {
    width: 100%;
    height: 100vh;
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    overflow: hidden;
  }

  section {
    height: 100vh;
  }

  h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 4vmax;
    text-align: center;
    text-wrap: balance;
    color: transparent;
    background-image: var(--gradient-btn);
    background-clip: text;
    animation: fadeIn 1s ease-in-out both;
    user-select: none;

    img {
      width: 6vmax;
      transform: translateY(1vmax);
    }
  }
</style>
